#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
MASTER_DIR="$CONFIG_HOME/gsr/shared"
MASTER_FILE="$MASTER_DIR/whitelist.json"
IDENTITIES_FILE="$MASTER_DIR/identities.json"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
JSON_TOOL="$SCRIPT_DIR/../whitelist-json.py"

usage() {
  cat <<'EOF'
Usage:
  mc-whitelist list
  mc-whitelist add premium <Minecraft-name>
  mc-whitelist add offline <Minecraft-name>
  mc-whitelist remove <Minecraft-name> [premium|offline|all]
  mc-whitelist apply
  mc-whitelist audit

premium obtains the global UUID from Mojang and also allows the matching
offline UUID. offline only allows Minecraft's deterministic OfflinePlayer UUID.

identities.json is the source of truth. whitelist.json is generated from it.
EOF
}

valid_name() {
  [[ "$1" =~ ^[A-Za-z0-9_]{3,16}$ ]]
}

require_master() {
  [[ -f "$IDENTITIES_FILE" ]] || {
    echo "No identities.json yet. Create it in $MASTER_DIR first." >&2
    exit 1
  }
}

build_master() {
  python3 "$JSON_TOOL" build "$IDENTITIES_FILE" "$MASTER_FILE"
}

active_container() {
  local script_path repo_root container_file container_name running=()
  script_path="$(readlink -f "$0")"
  repo_root="${GSR_REPO_ROOT:-$(cd "$(dirname "$script_path")/../.." && pwd)}"

  while IFS= read -r -d '' container_file; do
    container_name="$(sed -nE 's/^ContainerName=([^[:space:]#]+).*/\1/p' "$container_file" | head -n1)"
    [[ -n "$container_name" ]] || continue
    if podman inspect -f '{{.State.Running}}' "$container_name" 2>/dev/null | grep -qx true; then
      running+=("$container_name")
    fi
  done < <(find "$repo_root/environments" -mindepth 2 -maxdepth 2 -name '*.container' -print0)

  if ((${#running[@]} > 1)); then
    echo "More than one Minecraft environment is running; refusing to choose one." >&2
    exit 1
  fi
  # "No environment running" is a normal result (empty output, status 0).
  # A bare `(( )) && printf` would return 1 here and, through set -e on the
  # caller's assignment, abort `add`/`remove`/`apply` without a message.
  if ((${#running[@]} == 1)); then
    printf '%s\n' "${running[0]}"
  fi
  return 0
}

sync_start() {
  local environment="$1" repo_root container_file volume container image
  repo_root="${GSR_REPO_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)}"
  container_file="$repo_root/environments/$environment/$(find "$repo_root/environments/$environment" -maxdepth 1 -name '*.container' -printf '%f\n' | head -n1)"
  [[ -f "$container_file" ]] || {
    echo "Unknown or invalid environment: $environment" >&2
    exit 1
  }
  volume="$(sed -nE 's#^Volume=([^:[:space:]]+):/data(:[^[:space:]]*)?$#\1#p' "$container_file" | head -n1)"
  container="$(sed -nE 's/^ContainerName=([^[:space:]#]+).*/\1/p' "$container_file" | head -n1)"
  [[ -n "$volume" && -n "$container" ]] || {
    echo "Cannot determine volume or container for $environment." >&2
    exit 1
  }
  require_master
  podman volume exists "$volume" || podman volume create "$volume" >/dev/null
  image="localhost/$container:latest"
  podman run --rm --user 0 \
    -v "$volume:/data" \
    -v "$MASTER_FILE:/input/whitelist.json:ro" \
    --entrypoint sh "$image" \
    -c 'set -eu; cp /input/whitelist.json /data/.whitelist.gsr-new; chmod 644 /data/.whitelist.gsr-new; mv -f /data/.whitelist.gsr-new /data/whitelist.json'
  echo "Master whitelist applied to $environment before start."
}

apply_master() {
  local container
  build_master
  container="$(active_container)"
  if [[ -z "$container" ]]; then
    echo "Master whitelist saved. It will be applied when an environment starts."
    return 0
  fi

  podman cp "$MASTER_FILE" "$container:/data/whitelist.json"
  # podman cp preserves restrictive host modes. Minecraft itself runs as a
  # non-root user in the image, so make the already-copied file readable.
  podman exec --user 0 "$container" sh -lc 'chmod 644 /data/whitelist.json'
  # Same persistent-credential lookup as gsr-backup/switch-environment.sh:
  # with OVERRIDE_SERVER_PROPERTIES=FALSE the live rcon.password can differ
  # from the image's generated rcon-cli default.
  podman exec "$container" sh -ceu '
    password="$(sed -n "s/^rcon.password=//p" /data/server.properties)"
    [ -n "$password" ] || { echo "mc-whitelist: no rcon.password in /data/server.properties" >&2; exit 1; }
    export RCON_PASSWORD="$password"
    exec rcon-cli "$@"
  ' sh 'whitelist reload'
  echo "Master whitelist applied to $container."
}

case "${1:-}" in
  list)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    require_master
    build_master
    python3 "$JSON_TOOL" list "$IDENTITIES_FILE"
    ;;
  add)
    [[ $# -eq 3 ]] && valid_name "$3" || { usage >&2; exit 2; }
    case "$2" in
      premium|offline) ;;
      *) usage >&2; exit 2 ;;
    esac
    require_master
    python3 "$JSON_TOOL" add "$IDENTITIES_FILE" "$2" "$3"
    apply_master
    ;;
  remove)
    [[ $# -eq 2 || $# -eq 3 ]] && valid_name "$2" || { usage >&2; exit 2; }
    require_master
    identity="${3:-all}"
    case "$identity" in
      premium|offline)
        ;;
      all)
        ;;
      *) usage >&2; exit 2 ;;
    esac
    python3 "$JSON_TOOL" remove "$IDENTITIES_FILE" "$2" "$identity"
    apply_master
    ;;
  apply)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    require_master
    apply_master
    ;;
  audit)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    require_master
    python3 "$JSON_TOOL" audit "$IDENTITIES_FILE" "$MASTER_FILE"
    ;;
  sync-start)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    sync_start "$2"
    ;;
  -h|--help|help|'')
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
