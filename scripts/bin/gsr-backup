#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f "$0")"
REPO_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/../.." && pwd)"
ENVIRONMENTS_ROOT="$REPO_ROOT/environments"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
BACKUP_ROOT="$DATA_HOME/gsr/backups"
MARKER_ROOT="$STATE_HOME/gsr/backup-prepared"
# Optional server-side settings. The only key is GSR_SERVER_BACKUP_KEEP.
BACKUP_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/gsr/backup.conf"
DEFAULT_SERVER_BACKUP_KEEP=1
RESTORE_SOURCE_STAGE=""
RESTORE_INCOMING_STAGE=""
TEST_VOLUME=""
RESTORE_SOURCE_KEPT=""
# The staging directory of a create in progress, removed on exit: a failure
# under set -e ends the script without running create_backup's RETURN trap.
CREATE_STAGE=""
# File descriptor of the held per-environment lock, empty when not held.
BACKUP_LOCK_FD=""
# How long a backup or restore waits for another one of the same environment.
# It stays below the unit's TimeoutStopSec (900 s), so a waiting stop hook
# fails with a message instead of being killed.
BACKUP_LOCK_WAIT_SECONDS=600

cleanup_restore_staging() {
    [[ -z "$RESTORE_SOURCE_STAGE" ]] || rm -rf -- "$RESTORE_SOURCE_STAGE"
    [[ -z "$RESTORE_SOURCE_KEPT" ]] || \
        echo "gsr-backup: restore did not complete; its source backup was kept at $RESTORE_SOURCE_KEPT (delete it manually once no longer needed)." >&2
    [[ -z "$RESTORE_INCOMING_STAGE" ]] || rm -rf -- "$RESTORE_INCOMING_STAGE"
    if [[ -n "$CREATE_STAGE" ]]; then
        rm -rf -- "$CREATE_STAGE"
        echo "gsr-backup: backup of ${BACKUP_ENVIRONMENT:-?} FAILED (see above); its partial files were removed and the previous backups are unchanged." >&2
    fi
    [[ -z "$TEST_VOLUME" ]] || podman volume rm "$TEST_VOLUME" >/dev/null 2>&1 || true
}

trap cleanup_restore_staging EXIT

# A command reached through sudo -u does not necessarily inherit the service
# user's runtime directory. Podman and future restore commands need it when
# the backup tool is called remotely.
setup_user_runtime() {
    local runtime
    runtime="/run/user/$(id -u)"
    if [[ -z "${XDG_RUNTIME_DIR:-}" && -d "$runtime" ]]; then
        export XDG_RUNTIME_DIR="$runtime"
    fi
    if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S "${XDG_RUNTIME_DIR:-}/bus" ]]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
    fi
}

setup_user_runtime

# sudo -H changes HOME but intentionally keeps the caller's working directory.
# Podman must not be launched from an SSH user's private home that the service
# user cannot enter, especially while importing a streamed backup.
if ! cd "$HOME"; then
    echo "gsr-backup: cannot enter service home: $HOME" >&2
    exit 1
fi

usage() {
    cat <<'EOF'
Usage:
  gsr-backup prepare <environment>
  gsr-backup finalize <environment>
  gsr-backup create <environment>
  gsr-backup verify <environment>
  gsr-backup restore <environment> <new-volume>
  gsr-backup restore-server <environment>
  gsr-backup remove-test-volume <environment> <volume>
  gsr-backup list

Transport helpers (used by gsr-backup-pull only):
  gsr-backup share-info <environment>
  gsr-backup share-bundle <environment>
  gsr-backup receive-restore <environment>
  gsr-backup receive-test <environment> <new-volume>

prepare and finalize are systemd stop hooks. create only exports an environment
whose container is already stopped. Each environment keeps one verified local
backup under ~/.local/share/gsr/backups/ by default. To keep more, put
GSR_SERVER_BACKUP_KEEP=<1-999> (the number of snapshots per environment,
current included) in ~/.config/gsr/backup.conf. If that file is invalid,
backups are still made but no older backup is deleted until it is fixed.
EOF
}

fail() {
    echo "gsr-backup: $*" >&2
    return 1
}

# Podman never inherits the lock descriptor: a long-lived helper it might
# leave behind (such as the rootless pause process) must not keep holding the
# lock after this script has exited.
podman() {
    if [[ -n "$BACKUP_LOCK_FD" ]]; then
        command podman "$@" {BACKUP_LOCK_FD}>&-
    else
        command podman "$@"
    fi
}

# Takes the per-environment lock ($BACKUP_DIR/.lock). Everything that
# creates, rotates or restores snapshots of one environment holds it, so two
# writers (a manual create and a stop hook, two creates, a create during a
# restore) cannot delete each other's staging directories or snapshots. Only
# this process holds it: it is released by release_backup_lock or on exit.
# Never hold it across `systemctl stop/start`: the stop hooks take it too.
# $1 (optional) says what giving up leaves behind; the default is only true
# when nothing has been done yet.
acquire_backup_lock() {
    local lock_file="$BACKUP_DIR/.lock" outcome="${1:-nothing was changed}"

    [[ -z "$BACKUP_LOCK_FD" ]] || return 0
    mkdir -p "$BACKUP_DIR"
    chmod 700 "$BACKUP_ROOT" "$BACKUP_DIR"
    exec {BACKUP_LOCK_FD}>>"$lock_file"
    if ! flock -n "$BACKUP_LOCK_FD"; then
        echo "gsr-backup: waiting for another backup or restore of $BACKUP_ENVIRONMENT to finish ..." >&2
        if ! flock -w "$BACKUP_LOCK_WAIT_SECONDS" "$BACKUP_LOCK_FD"; then
            exec {BACKUP_LOCK_FD}>&-
            BACKUP_LOCK_FD=""
            fail "another backup or restore of $BACKUP_ENVIRONMENT still holds $lock_file after ${BACKUP_LOCK_WAIT_SECONDS} s; $outcome"
            return 1
        fi
    fi
}

release_backup_lock() {
    [[ -n "$BACKUP_LOCK_FD" ]] || return 0
    exec {BACKUP_LOCK_FD}>&-
    BACKUP_LOCK_FD=""
}

environment_file() {
    local environment="$1"
    local files=("$ENVIRONMENTS_ROOT/$environment"/*.container)

    [[ ${#files[@]} -eq 1 && -f "${files[0]}" ]] || return 1
    printf '%s\n' "${files[0]}"
}

load_environment() {
    local environment="$1" file

    file="$(environment_file "$environment")" || {
        fail "unknown or invalid environment: $environment"
        return 1
    }

    BACKUP_ENVIRONMENT="$environment"
    BACKUP_CONTAINER="$(sed -nE 's/^ContainerName=([^[:space:]#]+).*/\1/p' "$file" | head -n1)"
    BACKUP_VOLUME="$(sed -nE 's#^Volume=([^:[:space:]]+):/data(:[^[:space:]]*)?$#\1#p' "$file" | head -n1)"
    BACKUP_VERSION="$(sed -nE 's/^Environment=VERSION=([^[:space:]#]+).*/\1/p' "$file" | head -n1)"
    BACKUP_WORLD="$(sed -nE 's/^Environment=LEVEL=([^[:space:]#]+).*/\1/p' "$file" | head -n1)"
    BACKUP_SERVICE="$(basename "$file" .container)"

    [[ -n "$BACKUP_CONTAINER" && -n "$BACKUP_VOLUME" && -n "$BACKUP_VERSION" && -n "$BACKUP_WORLD" ]] || {
        fail "cannot determine container, /data volume, Minecraft version, or world for $environment"
        return 1
    }

    BACKUP_DIR="$BACKUP_ROOT/$BACKUP_ENVIRONMENT"
    SNAPSHOT_DIR="$BACKUP_DIR/snapshots"
    MARKER_FILE="$MARKER_ROOT/$BACKUP_ENVIRONMENT.prepared"
}

container_running() {
    podman inspect -f '{{.State.Running}}' "$BACKUP_CONTAINER" 2>/dev/null | grep -qx true
}

rcon_command() {
    podman exec "$BACKUP_CONTAINER" sh -ceu '
        password="$(sed -n "s/^rcon.password=//p" /data/server.properties)"
        [ -n "$password" ] || { echo "gsr-backup: no rcon.password in /data/server.properties" >&2; exit 1; }
        export RCON_PASSWORD="$password"
        exec rcon-cli "$@"
    ' sh "$@"
}

prepare() {
    load_environment "$1"
    mkdir -p "$MARKER_ROOT"
    chmod 700 "$MARKER_ROOT"
    rm -f "$MARKER_FILE"

    if ! container_running; then
        echo "gsr-backup: $BACKUP_ENVIRONMENT is not running; no stop backup prepared."
        return 0
    fi

    if ! rcon_command 'save-all flush'; then
        echo "gsr-backup: cannot flush $BACKUP_ENVIRONMENT; preserving the previous backup." >&2
        return 0
    fi

    umask 077
    printf '%s\n' "$(date --utc --iso-8601=seconds)" > "$MARKER_FILE"
    echo "gsr-backup: prepared clean backup of $BACKUP_ENVIRONMENT after stop."
}

write_manifest() {
    local target="$1" archive_name="$2" digest="$3" archive_size="$4" created_at="$5" commit

    commit="$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || printf 'unknown')"
    python3 - "$target" "$BACKUP_ENVIRONMENT" "$BACKUP_VOLUME" "$BACKUP_VERSION" "$BACKUP_WORLD" \
        "$archive_name" "$digest" "$archive_size" "$created_at" "$commit" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
payload = {
    "schema_version": 1,
    "created_at": sys.argv[9],
    "environment": sys.argv[2],
    "volume": sys.argv[3],
    "minecraft_version": sys.argv[4],
    "world_directory": sys.argv[5],
    "archive": sys.argv[6],
    "sha256": sys.argv[7],
    "archive_bytes": int(sys.argv[8]),
    "repository_commit": sys.argv[10],
    "includes": [
        "complete Podman /data volume",
        "private shared identities and whitelist source",
    ],
}
path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
path.chmod(0o600)
PY
}

copy_shared_identity_source() {
    local destination="$1" config_home="${XDG_CONFIG_HOME:-$HOME/.config}" source
    local shared="$config_home/gsr/shared"

    mkdir -p "$destination"
    for source in identities.json whitelist.json; do
        if [[ -f "$shared/$source" ]]; then
            cp -p "$shared/$source" "$destination/$source"
            chmod 600 "$destination/$source"
        fi
    done
}

verify_snapshot() {
    local snapshot archive checksum

    snapshot="$1"
    archive="$snapshot/volume.tar.zst"
    checksum="$archive.sha256"

    # Every step returns explicitly: this function is also called inside
    # $(...), where bash does not inherit set -e, so a failed check must not
    # fall through to a later successful command.
    [[ -f "$archive" && -f "$checksum" && -f "$snapshot/manifest.json" ]] || {
        fail "snapshot is incomplete: $snapshot"
        return 1
    }
    (
        cd "$snapshot" &&
        sha256sum --check --status "volume.tar.zst.sha256"
    ) || { fail "checksum mismatch: $snapshot"; return 1; }
    zstd -tq "$archive" || { fail "zstd test failed: $archive"; return 1; }
    zstd -dcq "$archive" | tar -tf - >/dev/null || { fail "tar listing failed: $archive"; return 1; }
    python3 -m json.tool "$snapshot/manifest.json" >/dev/null || { fail "invalid manifest: $snapshot"; return 1; }
}

verify_snapshot_environment() {
    local snapshot="$1" expected_environment="$2"

    verify_snapshot "$snapshot"
    python3 - "$snapshot/manifest.json" "$expected_environment" <<'PY'
import json
import sys

payload = json.load(open(sys.argv[1], encoding="utf-8"))
if payload.get("environment") != sys.argv[2]:
    raise SystemExit("backup environment does not match")
PY
}

snapshot_summary() {
    local snapshot="$1"

    python3 - "$snapshot/manifest.json" <<'PY'
import json
import sys

payload = json.load(open(sys.argv[1], encoding="utf-8"))
created = payload.get("created_at")
size = payload.get("archive_bytes")
if not isinstance(created, str) or not created:
    raise SystemExit("backup manifest has no creation timestamp")
if not isinstance(size, int) or size < 0:
    raise SystemExit("backup manifest has no archive size")

units = ("B", "KiB", "MiB", "GiB", "TiB")
value = float(size)
index = 0
while value >= 1024 and index < len(units) - 1:
    value /= 1024
    index += 1
print(f"{created}\t{value:.2f} {units[index]}")
PY
}

# Retention value meaning "the setting is invalid: delete nothing".
KEEP_PAUSED=0

# Warns on stderr that the retention setting is unusable and prints
# $KEEP_PAUSED: rotation is paused, every existing snapshot is kept.
keep_setting_invalid() {
    echo "gsr-backup: WARNING: $*. Rotation of server backups is PAUSED: the backup is still made, but no older backup is deleted until $BACKUP_CONFIG is fixed." >&2
    printf '%s\n' "$KEEP_PAUSED"
}

# Prints GSR_SERVER_BACKUP_KEEP from $BACKUP_CONFIG, or the default (1) when
# the file does not exist or does not set it. Anything it does not understand
# produces a loud warning on stderr (naming the file and the bad value) and
# prints $KEEP_PAUSED (0): an invalid setting must never stop the automatic
# stop-hook backups, and must never delete snapshots either (falling back to
# keep=1 would turn a typo in, say, a keep=3 file into data loss). The cost
# is disk space: snapshots accumulate until the file is fixed.
# Called inside $(...): it always succeeds and prints exactly one number.
server_backup_keep() {
    local line value="" found=false line_number=0

    if [[ ! -e "$BACKUP_CONFIG" ]]; then
        printf '%s\n' "$DEFAULT_SERVER_BACKUP_KEEP"
        return 0
    fi
    [[ -f "$BACKUP_CONFIG" && -r "$BACKUP_CONFIG" ]] || {
        keep_setting_invalid "cannot read $BACKUP_CONFIG"
        return 0
    }
    while IFS= read -r line || [[ -n "$line" ]]; do
        line_number=$((line_number + 1))
        line="${line%%#*}"
        [[ "$line" =~ ^[[:space:]]*$ ]] && continue
        if [[ "$line" =~ ^[[:space:]]*GSR_SERVER_BACKUP_KEEP[[:space:]]*=[[:space:]]*([^[:space:]]*)[[:space:]]*$ ]]; then
            found=true
            value="${BASH_REMATCH[1]}"
        else
            keep_setting_invalid "$BACKUP_CONFIG line $line_number: expected GSR_SERVER_BACKUP_KEEP=<number>, found '$line'"
            return 0
        fi
    done < "$BACKUP_CONFIG"

    if [[ "$found" == false ]]; then
        printf '%s\n' "$DEFAULT_SERVER_BACKUP_KEEP"
        return 0
    fi
    [[ "$value" =~ ^[1-9][0-9]{0,2}$ ]] || {
        keep_setting_invalid "GSR_SERVER_BACKUP_KEEP in $BACKUP_CONFIG must be a whole number from 1 to 999, not '$value'"
        return 0
    }
    printf '%s\n' "$value"
}

# Keeps $current plus the newest (keep - 1) other completed snapshots and
# removes everything else in the snapshot directory, including leftover
# staging directories. With keep=1 this removes every other directory. With
# keep=$KEEP_PAUSED (an invalid setting) it removes nothing at all.
remove_old_snapshots() {
    local current="$1" keep="$2" snapshot kept=1

    (( keep != KEEP_PAUSED )) || return 0

    while IFS= read -r -d '' snapshot; do
        [[ "$snapshot" == "$current" ]] && continue
        # Snapshot names start with a UTC timestamp, so a reverse name sort
        # visits the newest first.
        if (( kept < keep )) && [[ "$(basename "$snapshot")" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+$ ]]; then
            kept=$((kept + 1))
            continue
        fi
        rm -rf -- "$snapshot"
    done < <(find "$SNAPSHOT_DIR" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z -r)
}

create_backup() {
    local allow_running="$1" created_at snapshot_id stage archive digest archive_size current_target keep
    local took_lock=false

    # A restore calls this while it already holds the lock.
    if [[ -z "$BACKUP_LOCK_FD" ]]; then
        acquire_backup_lock
        took_lock=true
    fi
    # An invalid retention setting warns and pauses rotation (keep=0).
    keep="$(server_backup_keep)"
    command -v zstd >/dev/null || fail "zstd is required for backups."
    command -v tar >/dev/null || fail "tar is required for backups."
    podman volume exists "$BACKUP_VOLUME" || fail "Podman volume does not exist: $BACKUP_VOLUME"

    if [[ "$allow_running" == false ]] && container_running; then
        fail "$BACKUP_ENVIRONMENT is still running; stop it before using create."
    fi

    mkdir -p "$SNAPSHOT_DIR"
    chmod 700 "$BACKUP_ROOT" "$BACKUP_DIR" "$SNAPSHOT_DIR"
    umask 077
    created_at="$(date --utc --iso-8601=seconds)"
    snapshot_id="$(date --utc +%Y%m%dT%H%M%SZ)-$RANDOM$RANDOM"
    stage="$(mktemp -d "$SNAPSHOT_DIR/.staging.XXXXXX")"
    CREATE_STAGE="$stage"
    archive="$stage/volume.tar.zst"

    cleanup_stage() {
        rm -rf -- "$stage"
    }
    trap cleanup_stage RETURN

    echo "gsr-backup: exporting $BACKUP_VOLUME for $BACKUP_ENVIRONMENT ..."
    podman volume export "$BACKUP_VOLUME" | zstd -T0 -q -o "$archive"
    digest="$(sha256sum "$archive" | awk '{print $1}')"
    printf '%s  %s\n' "$digest" "volume.tar.zst" > "$archive.sha256"
    archive_size="$(stat -c %s "$archive")"
    copy_shared_identity_source "$stage/shared"
    write_manifest "$stage/manifest.json" "volume.tar.zst" "$digest" "$archive_size" "$created_at"
    verify_snapshot "$stage"
    # Make the new archive durable before the previous one is deleted, so a
    # power loss right after rotation cannot leave only an unflushed archive.
    sync -- "$archive" "$archive.sha256" "$stage/manifest.json" "$stage"

    current_target="$(readlink -e "$BACKUP_DIR/current" 2>/dev/null || true)"
    mv "$stage" "$SNAPSHOT_DIR/$snapshot_id"
    CREATE_STAGE=""
    stage="$SNAPSHOT_DIR/$snapshot_id"
    # -fnT: a .current.new left by an interrupted run must be replaced, not
    # followed (plain ln -s would create the link inside the old snapshot and
    # then point current at that old, soon-deleted snapshot).
    ln -sfnT "snapshots/$snapshot_id" "$BACKUP_DIR/.current.new"
    mv -Tf "$BACKUP_DIR/.current.new" "$BACKUP_DIR/current"
    sync -- "$SNAPSHOT_DIR" "$BACKUP_DIR"
    remove_old_snapshots "$stage" "$keep"
    trap - RETURN
    [[ "$took_lock" == false ]] || release_backup_lock

    echo "gsr-backup: verified backup of $BACKUP_ENVIRONMENT is now current."
    if (( keep == KEEP_PAUSED )); then
        # Repeated after the export output, so it is not missed.
        echo "gsr-backup: WARNING: rotation is paused because $BACKUP_CONFIG is invalid; no older backup was deleted (directories in $SNAPSHOT_DIR: $(find "$SNAPSHOT_DIR" -mindepth 1 -maxdepth 1 -type d | wc -l)). Fix the file to resume rotation." >&2
    elif (( keep == 1 )); then
        [[ -z "$current_target" ]] || echo "gsr-backup: replaced previous local backup."
    else
        echo "gsr-backup: keeping up to $keep server backups of $BACKUP_ENVIRONMENT (GSR_SERVER_BACKUP_KEEP)."
    fi
}

finalize() {
    load_environment "$1"

    [[ -f "$MARKER_FILE" ]] || {
        echo "gsr-backup: no prepared stop for $BACKUP_ENVIRONMENT; previous backup kept."
        return 0
    }
    rm -f "$MARKER_FILE"

    if container_running; then
        echo "gsr-backup: $BACKUP_ENVIRONMENT still runs; previous backup kept." >&2
        return 0
    fi

    # Quadlet's generated stop path ends the container through `podman rm -f`.
    # systemd can therefore report `signal` for an intentional, clean stop.
    # Any other result (timeout, exit-code, core-dump, watchdog, oom-kill, ...)
    # means the server may have written again after the flush and then been
    # killed, so the volume can be inconsistent even though the archive would
    # pass every integrity check. Such a stop must not rotate away the
    # previous backup. Without SERVICE_RESULT (run by hand) it counts as
    # success, as before.
    case "${SERVICE_RESULT:-success}" in
        success) ;;
        signal)
            echo "gsr-backup: $BACKUP_ENVIRONMENT stopped with systemd result signal after clean flush (normal for Quadlet); exporting backup."
            ;;
        *)
            echo "gsr-backup: $BACKUP_ENVIRONMENT stopped abnormally (systemd result '$SERVICE_RESULT'); no backup exported, previous backup kept." >&2
            return 0
            ;;
    esac

    create_backup true
}

verify_current() {
    load_environment "$1"
    local current created size

    current="$(readlink -e "$BACKUP_DIR/current" 2>/dev/null || true)"
    [[ -n "$current" && -d "$current" ]] || fail "no current backup for $BACKUP_ENVIRONMENT"
    verify_snapshot "$current"
    read -r created size < <(snapshot_summary "$current")
    echo "gsr-backup: current backup for $BACKUP_ENVIRONMENT is valid (created $created; $size)."
}

current_snapshot() {
    local current

    current="$(readlink -e "$BACKUP_DIR/current" 2>/dev/null || true)"
    # Called as $(current_snapshot): set -e is not inherited there, so return
    # explicitly instead of printing an unverified path.
    [[ -n "$current" && -d "$current" ]] || { fail "no current backup for $BACKUP_ENVIRONMENT"; return 1; }
    verify_snapshot "$current" || return 1
    printf '%s\n' "$current"
}

share_info() {
    local current

    load_environment "$1"
    current="$(current_snapshot)"
    cat "$current/manifest.json"
}

share_bundle() {
    local current

    load_environment "$1"
    current="$(current_snapshot)"
    # stdout is deliberately binary-only. This is consumed over SSH by the
    # local pull tool; diagnostics remain on stderr through fail()/tar.
    if [[ -d "$current/shared" ]]; then
        tar -C "$current" -cf - manifest.json volume.tar.zst volume.tar.zst.sha256 shared
    else
        tar -C "$current" -cf - manifest.json volume.tar.zst volume.tar.zst.sha256
    fi
}

restore_current() {
    local environment="$1" target_volume="$2" current

    load_environment "$environment"
    [[ "$target_volume" =~ ^[[:alnum:]][[:alnum:]_.-]*$ ]] || {
        fail "invalid target volume name: $target_volume"
        return 1
    }
    [[ "$target_volume" != "$BACKUP_VOLUME" ]] || {
        fail "restore requires a new volume name, not the live volume: $BACKUP_VOLUME"
        return 1
    }
    if podman volume exists "$target_volume"; then
        fail "target volume already exists: $target_volume"
        return 1
    fi

    current="$(readlink -e "$BACKUP_DIR/current" 2>/dev/null || true)"
    [[ -n "$current" && -d "$current" ]] || fail "no current backup for $BACKUP_ENVIRONMENT"
    verify_snapshot "$current"

    podman volume create "$target_volume" >/dev/null
    if ! zstd -dcq "$current/volume.tar.zst" | podman volume import "$target_volume" -; then
        fail "restore failed; the new volume was left in place for inspection: $target_volume"
        return 1
    fi
    echo "gsr-backup: restored $BACKUP_ENVIRONMENT into new volume $target_volume."
}

restore_live_from_snapshot() {
    local environment="$1" source="$2" protected_source="" pre_restore current_before current_after

    load_environment "$environment"
    # Held while the source is checked and copied, and again from after the
    # stop until the import is done; never across systemctl stop/start, whose
    # stop hooks take it themselves.
    acquire_backup_lock
    verify_snapshot_environment "$source" "$environment"

    # The automatic stop hook rotates server-local snapshots (with the default
    # GSR_SERVER_BACKUP_KEEP=1, the only one away). Protect a
    # source from that snapshot directory before stopping the service.
    if [[ "$source" == "$SNAPSHOT_DIR"/* ]]; then
        protected_source="$(mktemp -d "$BACKUP_DIR/.restore-source.XXXXXX")"
        # A partial copy is deleted on failure ...
        RESTORE_SOURCE_STAGE="$protected_source"
        cp -a "$source/." "$protected_source/"
        source="$protected_source"
        # ... but a complete one is kept from now on, until the restore has
        # succeeded: every later step (the stop hook, a failing stop, the
        # rollback backup) can rotate the original away, and then this copy
        # is the last one of the requested restore point.
        RESTORE_SOURCE_STAGE=""
        RESTORE_SOURCE_KEPT="$protected_source"
    fi

    current_before="$(readlink -e "$BACKUP_DIR/current" 2>/dev/null || true)"

    if systemctl --user is-active --quiet "$BACKUP_SERVICE.service"; then
        echo "gsr-backup: stopping $BACKUP_ENVIRONMENT and creating a rollback backup ..."
        release_backup_lock
        systemctl --user stop "$BACKUP_SERVICE.service"
        acquire_backup_lock "$BACKUP_ENVIRONMENT was stopped for the restore and stays stopped; the live volume was not changed (gsr start $BACKUP_ENVIRONMENT starts it again)"
    else
        # A stopped service bypasses the stop hook, so make the rollback backup
        # explicitly before modifying the named live volume.
        create_backup false
    fi
    if container_running; then
        fail "$BACKUP_ENVIRONMENT is still running after stop"
        return 1
    fi
    # Stop hooks intentionally keep the previous snapshot if their export
    # fails. A restore must never rely on that ambiguous result: if the hook
    # did not rotate current, create and verify the rollback backup ourselves.
    current_after="$(readlink -e "$BACKUP_DIR/current" 2>/dev/null || true)"
    if [[ -z "$current_after" || "$current_after" == "$current_before" ]]; then
        create_backup false
    fi
    pre_restore="$(current_snapshot)"

    echo "gsr-backup: replacing live volume $BACKUP_VOLUME from the verified backup ..."
    podman volume rm "$BACKUP_VOLUME"
    podman volume create "$BACKUP_VOLUME" >/dev/null
    if ! zstd -dcq "$source/volume.tar.zst" | podman volume import "$BACKUP_VOLUME" -; then
        echo "gsr-backup: restore import failed; attempting rollback volume recovery ..." >&2
        podman volume rm "$BACKUP_VOLUME" || true
        podman volume create "$BACKUP_VOLUME" >/dev/null
        if ! zstd -dcq "$pre_restore/volume.tar.zst" | podman volume import "$BACKUP_VOLUME" -; then
            fail "restore and automatic rollback both failed; service remains stopped"
            return 1
        fi
        fail "restore failed; the pre-restore volume was recovered and remains stopped"
        return 1
    fi

    release_backup_lock
    systemctl --user start "$BACKUP_SERVICE.service"
    [[ -z "$protected_source" ]] || rm -rf -- "$protected_source"
    RESTORE_SOURCE_STAGE=""
    RESTORE_SOURCE_KEPT=""
    echo "gsr-backup: $BACKUP_ENVIRONMENT now runs from the restored volume."
    echo "gsr-backup: the current server backup is the pre-restore rollback point."
}

restore_server_current() {
    local environment="$1" current confirmation

    load_environment "$environment"
    current="$(current_snapshot)"
    echo "This replaces the live volume $BACKUP_VOLUME with the current local backup."
    echo "A fresh rollback backup of the live volume will be created first."
    read -rp "Type RESTORE-$environment to continue: " confirmation
    [[ "$confirmation" == "RESTORE-$environment" ]] || {
        echo "gsr-backup: restore cancelled."
        return 0
    }
    restore_live_from_snapshot "$environment" "$current"
}

receive_restore() {
    local environment="$1" stage

    load_environment "$environment"
    mkdir -p "$BACKUP_DIR"
    chmod 700 "$BACKUP_ROOT" "$BACKUP_DIR"
    stage="$(mktemp -d "$BACKUP_DIR/.incoming-restore.XXXXXX")"
    RESTORE_INCOMING_STAGE="$stage"

    # The client sends a tar containing exactly a verified snapshot's public
    # backup files. Extraction stays inside a private staging directory until
    # all integrity checks pass.
    tar -xf - -C "$stage" --no-same-owner --no-same-permissions
    verify_snapshot_environment "$stage" "$environment"
    restore_live_from_snapshot "$environment" "$stage"
    rm -rf -- "$stage"
    RESTORE_INCOMING_STAGE=""
    echo "gsr-backup: received and restored verified backup for $environment."
}

valid_test_volume() {
    local volume="$1"
    [[ "$volume" =~ ^gsr-upload-test-${BACKUP_ENVIRONMENT}-[0-9]{8}T[0-9]{6}Z-[0-9]+$ ]]
}

verify_imported_test_volume() {
    local volume="$1"

    # Exporting only lists the newly created test volume. It never mounts or
    # modifies the live volume, and confirms that the essential server and
    # world files survived the upload and Podman import.
    if ! podman volume export "$volume" | tar -tf - | awk -v world="$BACKUP_WORLD" '
        {
            clean = $0
            sub(/^\.\//, "", clean)
            if (clean == "server.properties") server_properties = 1
            if (clean == world "/level.dat") level_data = 1
        }
        END { exit !(server_properties && level_data) }
    '; then
        fail "imported test volume is missing server.properties or $BACKUP_WORLD/level.dat"
        return 1
    fi
}

receive_test() {
    local environment="$1" target_volume="$2" stage

    load_environment "$environment"
    valid_test_volume "$target_volume" || {
        fail "invalid test volume name: $target_volume"
        return 1
    }
    [[ "$target_volume" != "$BACKUP_VOLUME" ]] || {
        fail "test import refuses the live volume: $BACKUP_VOLUME"
        return 1
    }
    if podman volume exists "$target_volume"; then
        fail "test volume already exists: $target_volume"
        return 1
    fi

    mkdir -p "$BACKUP_DIR"
    chmod 700 "$BACKUP_ROOT" "$BACKUP_DIR"
    stage="$(mktemp -d "$BACKUP_DIR/.incoming-test.XXXXXX")"
    RESTORE_INCOMING_STAGE="$stage"

    tar -xf - -C "$stage" --no-same-owner --no-same-permissions
    verify_snapshot_environment "$stage" "$environment"

    echo "gsr-backup: importing verified upload into test volume $target_volume ..."
    podman volume create "$target_volume" >/dev/null
    TEST_VOLUME="$target_volume"
    if ! zstd -dcq "$stage/volume.tar.zst" | podman volume import "$target_volume" -; then
        fail "test volume import failed; the partial test volume will be removed"
        return 1
    fi
    verify_imported_test_volume "$target_volume"

    rm -rf -- "$stage"
    RESTORE_INCOMING_STAGE=""
    TEST_VOLUME=""
    echo "gsr-backup: upload test succeeded in volume $target_volume."
}

remove_test_volume() {
    local environment="$1" target_volume="$2"

    load_environment "$environment"
    valid_test_volume "$target_volume" || {
        fail "refusing to remove a non-test volume: $target_volume"
        return 1
    }
    if ! podman volume exists "$target_volume"; then
        fail "test volume does not exist: $target_volume"
        return 1
    fi
    if podman ps --all --filter "volume=$target_volume" --format '{{.ID}}' | grep -q .; then
        fail "test volume is attached to a container: $target_volume"
        return 1
    fi
    podman volume rm "$target_volume" >/dev/null
    echo "gsr-backup: removed test volume $target_volume."
}

show_list() {
    local environment current created size

    for environment in "$ENVIRONMENTS_ROOT"/*; do
        [[ -d "$environment" ]] || continue
        environment="$(basename "$environment")"
        if ! load_environment "$environment" 2>/dev/null; then
            continue
        fi
        current="$(readlink -e "$BACKUP_DIR/current" 2>/dev/null || true)"
        if [[ -z "$current" || ! -d "$current" ]]; then
            printf '%-16s no backup\n' "$environment"
            continue
        fi
        if ! read -r created size < <(snapshot_summary "$current"); then
            printf '%-16s current: invalid manifest\n' "$environment"
            continue
        fi
        printf '%-16s current: %s  %s\n' "$environment" "$created" "$size"
    done
}

case "${1:-}" in
    prepare|finalize|create|verify)
        [[ $# -eq 2 ]] || { usage >&2; exit 2; }
        case "$1" in
            prepare) prepare "$2" ;;
            finalize) finalize "$2" ;;
            create)
                load_environment "$2"
                create_backup false
                ;;
            verify) verify_current "$2" ;;
        esac
        ;;
    restore)
        [[ $# -eq 3 ]] || { usage >&2; exit 2; }
        restore_current "$2" "$3"
        ;;
    restore-server)
        [[ $# -eq 2 ]] || { usage >&2; exit 2; }
        restore_server_current "$2"
        ;;
    remove-test-volume)
        [[ $# -eq 3 ]] || { usage >&2; exit 2; }
        remove_test_volume "$2" "$3"
        ;;
    list)
        [[ $# -eq 1 ]] || { usage >&2; exit 2; }
        show_list
        ;;
    share-info|share-bundle)
        [[ $# -eq 2 ]] || { usage >&2; exit 2; }
        case "$1" in
            share-info) share_info "$2" ;;
            share-bundle) share_bundle "$2" ;;
        esac
        ;;
    receive-restore)
        [[ $# -eq 2 ]] || { usage >&2; exit 2; }
        receive_restore "$2"
        ;;
    receive-test)
        [[ $# -eq 3 ]] || { usage >&2; exit 2; }
        receive_test "$2" "$3"
        ;;
    -h|--help|help|'')
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
